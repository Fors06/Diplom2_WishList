<Window x:Class="WishList.Views.ProgrammerView.ProgrammerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:convertes="clr-namespace:WishList.Data.Convertes"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowState="Maximized"
        Title="Панель программиста"
        Height="450" Width="800">

    <Window.Resources>
        <convertes:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <convertes:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <convertes:StringToBrushConverter x:Key="StringToBrushConverter"/>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseDown="Border_MouseDown">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💻" FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="ПАНЕЛЬ ПРОГРАММИСТА" 
                              Foreground="{StaticResource TextBrush}" 
                              FontSize="18" 
                              FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentProgrammerName}" 
                              Foreground="{StaticResource AccentBrush}" 
                              FontSize="14" 
                              FontWeight="SemiBold"
                              Margin="15,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock Text="{Binding CurrentDate}" 
                              Foreground="{StaticResource TextSecondaryBrush}" 
                              FontSize="12"
                              Margin="0,0,15,0"/>

                    <Button Command="{Binding LogoutCommand}"
                            ToolTip="Выйти из системы"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Content="🚪"
                            FontSize="14"
                            Margin="0,0,10,0"
                            Width="30" Height="30"/>

                    <Button Command="{Binding ToggleThemeCommand}"
                            ToolTip="Сменить тему"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Content="🌙"
                            FontSize="12"
                            Margin="0,0,10,0"
                            Width="30" Height="30"/>

                    <Button Command="{Binding RefreshCommand}"
                            ToolTip="Обновить данные"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Content="🔄"
                            FontSize="12"
                            Margin="0,0,10,0"
                            Width="30" Height="30"/>

                    <Button x:Name="MinimizeButton" 
                            Style="{StaticResource WindowControlButtonStyle}"
                            Content="─"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="MinimizeButton_Click"
                            Margin="0,0,5,0"
                            Width="30" Height="30"/>

                    <Button x:Name="MaximizeButton" 
                            Style="{StaticResource WindowControlButtonStyle}"
                            Content="🗖"
                            FontSize="12"
                            Click="MaximizeButton_Click"
                            Margin="0,0,5,0"
                            Width="30" Height="30"/>

                    <Button Style="{StaticResource CloseButtonStyle}" 
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" 
                      HorizontalScrollBarVisibility="Auto" 
                      Padding="20,12" Background="Transparent">
            <ItemsControl ItemsSource="{Binding StatisticsCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource StatCardStyle}" 
                                Width="180" Height="80" 
                                Background="{Binding Color, Converter={StaticResource StringToBrushConverter}}">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="22" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding Title}" FontSize="11" Foreground="White" Opacity="0.9"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Main Content -->
        <Border Grid.Row="2" Background="{StaticResource PrimaryBrush}" 
                Margin="20,10,20,20" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" Background="{StaticResource SecondaryBrush}" 
                        CornerRadius="8,8,0,0" Padding="15,10" 
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📋 Мои задачи" 
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Width="300" Height="32"
                                 Tag="🔍 Поиск по задачам..."
                                 FontSize="12"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Статус:" VerticalAlignment="Center" 
                                       Foreground="{StaticResource TextBrush}" FontSize="12"
                                       Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding StatusFilterItems}"
                                      SelectedItem="{Binding SelectedStatusFilter}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource ModernComboBox}"
                                      Width="140" Height="32"
                                      Margin="0,0,15,0"/>

                            <Button Content="❌ Очистить"
                                    Command="{Binding ClearFiltersCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Background="{StaticResource BorderBrush}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Padding="12,6"
                                    FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Split View -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tasks DataGrid -->
                    <Border Grid.Column="0" CornerRadius="0,0,0,8" Background="{StaticResource PrimaryBrush}">
                        <DataGrid ItemsSource="{Binding FilteredTasks}"
                                  SelectedItem="{Binding SelectedTask}"
                                  Style="{StaticResource ModernDataGrid}"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                                  RowStyle="{StaticResource ModernDataGridRow}"
                                  CellStyle="{StaticResource ModernDataGridCell}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding OrderNumber}" Width="50"/>
                                <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="2*" MinWidth="200"/>
                                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="1.5*"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="100"/>
                                <DataGridTextColumn Header="Приоритет" Binding="{Binding PriorityName}" Width="80"/>
                                <DataGridTextColumn Header="Срок" Binding="{Binding DueDateString}" Width="90"/>
                                <DataGridTextColumn Header="Прогресс" Binding="{Binding ProgressString}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Right Panel -->
                    <Border Grid.Column="1" Background="{StaticResource SecondaryBrush}" 
                            CornerRadius="0,0,8,0" BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1,0,0,0" Padding="12">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Task Info Card -->
                                <Border Background="{StaticResource CardBrush}" CornerRadius="8" 
                                        Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="📌 Информация о задаче" 
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="14" FontWeight="Bold"
                                                   Margin="0,0,0,12"/>

                                        <TextBlock Text="{Binding SelectedTask.Title, FallbackValue='Не выбрана'}" 
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>

                                        <TextBlock Text="Описание:" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedTask.Description, FallbackValue='—'}" 
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,10"/>

                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Клиент:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Менеджер:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SelectedTask.ClientName, FallbackValue='—'}" 
                                                       FontSize="12" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTask.ManagerName, FallbackValue='—'}" 
                                                       FontSize="12" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="6" Padding="8" Margin="0,0,4,0"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="📅 Срок" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding SelectedTask.DueDateString, FallbackValue='—'}" 
                                                               FontSize="14" FontWeight="Bold"
                                                               Foreground="{StaticResource TextBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="6" Padding="8" Margin="2,0,2,0"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="⏱️ Часы" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding SelectedTask.EstimatedHoursString, FallbackValue='—'}" 
                                                               FontSize="14" FontWeight="Bold"
                                                               Foreground="{StaticResource TextBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="6" Padding="8" Margin="4,0,0,0"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="✅ Прогресс" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding SelectedTask.ProgressString, FallbackValue='0%'}" 
                                                               FontSize="14" FontWeight="Bold"
                                                               Foreground="{StaticResource SuccessBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Status Update -->
                                        <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Изменить статус:" 
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="11" VerticalAlignment="Center"/>

                                                <ComboBox Grid.Column="1" 
                                                          ItemsSource="{Binding AllStatuses}"
                                                          SelectedValue="{Binding SelectedTask.StatusId, Mode=TwoWay}"
                                                          SelectedValuePath="Id"
                                                          DisplayMemberPath="Name"
                                                          Style="{StaticResource ModernComboBox}"
                                                          Height="32" Margin="10,0" FontSize="11"/>

                                                <Button Grid.Column="2" 
                                                        Content="Обновить"
                                                        Command="{Binding UpdateStatusCommand}"
                                                        Style="{StaticResource ModernButton}"
                                                        Background="{StaticResource AccentBrush}"
                                                        Padding="15,6" FontSize="11"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Work Plans Header -->
                                <Border Background="{StaticResource CardBrush}" CornerRadius="8" 
                                        Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📋 Планы работ" 
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="14" FontWeight="Bold"/>
                                        <Button Grid.Column="1" 
                                                Content="➕ Добавить план"
                                                Command="{Binding AddWorkPlanCommand}"
                                                Style="{StaticResource ModernButton}"
                                                Background="{StaticResource SuccessBrush}"
                                                Padding="12,6" FontSize="11"/>
                                    </Grid>
                                </Border>

                                <!-- Work Plans List -->
                                <ItemsControl ItemsSource="{Binding TaskWorkPlans}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBrush}" CornerRadius="8" 
                                                    Padding="12" Margin="0,0,0,8"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding PlanDescription}" 
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>

                                                        <Border Grid.Column="1" Background="{StaticResource InfoBrush}" 
                                                                CornerRadius="10" Padding="6,2" Margin="8,0,8,0">
                                                            <TextBlock Text="{Binding EstimatedHours}" 
                                                                       FontSize="10" Foreground="White"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <Button Content="✏️"
                                                                    Command="{Binding DataContext.EditWorkPlanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource TextButton}"
                                                                    Padding="6,3"
                                                                    FontSize="12"/>
                                                            <Button Content="🗑️"
                                                                    Command="{Binding DataContext.DeleteWorkPlanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}"
                                                                    Style="{StaticResource TextButton}"
                                                                    Foreground="{StaticResource ErrorBrush}"
                                                                    Padding="6,3"
                                                                    Margin="4,0,0,0"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="План действий:" 
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding TestSteps, FallbackValue='Не указан'}" 
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <TextBlock Text="Выберите задачу для просмотра планов работ" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Margin="0,20"
                                           Visibility="{Binding SelectedTask, Converter={StaticResource InverseBooleanConverter}}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="{StaticResource PrimaryBrush}" 
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="11"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Style="{StaticResource ModernProgressBar}"
                           Width="120" Height="6"
                           IsIndeterminate="{Binding IsLoading}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>