<Window x:Class="WishList.Views.ManagerView.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:convertes="clr-namespace:WishList.Data.Convertes"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Title="Панель менеджера">

    <Window.Resources>
        <convertes:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <convertes:StringToBrushConverter x:Key="StringToBrushConverter"/>
        <convertes:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- Фиксируем цвет текста при наведении -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- Стиль для TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderThickness="0" 
                                Padding="{TemplateBinding Padding}"
                                Margin="2,0">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Border" Property="CornerRadius" Value="6,6,0,0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Убираем изменение цвета текста при наведении -->
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseDown="Border_MouseDown">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👨‍💼" FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="ПАНЕЛЬ МЕНЕДЖЕРА" 
                               Foreground="{StaticResource TextBrush}" 
                               FontSize="18" 
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentDate}" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="12"
                               Margin="0,0,15,0"/>

                    <Button Command="{Binding LogoutCommand}"
                            ToolTip="Выйти из системы"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Content="🚪"
                            FontSize="14"
                            Margin="0,0,10,0"
                            Width="30" Height="30"/>

                    <Button Command="{Binding ToggleThemeCommand}"
                            ToolTip="Сменить тему"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Content="🌙"
                            FontSize="12"
                            Margin="0,0,10,0"
                            Width="30" Height="30"/>

                    <Button Command="{Binding RefreshCommand}"
                            ToolTip="Обновить данные"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Content="🔄"
                            FontSize="12"
                            Margin="0,0,10,0"
                            Width="30" Height="30"/>

                    <Button x:Name="MinimizeButton" 
                            Style="{StaticResource WindowControlButtonStyle}"
                            Content="─"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="MinimizeButton_Click"
                            Margin="0,0,5,0"
                            Width="30" Height="30"/>

                    <Button x:Name="MaximizeButton" 
                            Style="{StaticResource WindowControlButtonStyle}"
                            Content="🗖"
                            FontSize="12"
                            Click="MaximizeButton_Click"
                            Margin="0,0,5,0"
                            Width="30" Height="30"/>

                    <Button Style="{StaticResource CloseButtonStyle}" 
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statistics Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" 
                      HorizontalScrollBarVisibility="Auto" 
                      Padding="20,12" Background="Transparent"
                      UseLayoutRounding="True">
            <ItemsControl ItemsSource="{Binding StatisticsCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource StatCardStyle}" 
                                MinWidth="200" MinHeight="80" 
                                Width="220" Height="90"
                                Background="{Binding Color, Converter={StaticResource StringToBrushConverter}}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="3" Opacity="0.15" BlurRadius="10" Direction="270"/>
                            </Border.Effect>
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                           Text="{Binding Icon}" 
                                           Style="{StaticResource IconTextStyle}"
                                           FontSize="20"
                                           Margin="0,0,12,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Value}" 
                                               FontSize="18" 
                                               FontWeight="Bold" 
                                               Foreground="White"/>
                                    <TextBlock Text="{Binding Title}" 
                                               FontSize="11" 
                                               Foreground="White" 
                                               Opacity="0.9"
                                               Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="9" 
                                               Foreground="White" 
                                               Opacity="0.7"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Main Content - TabControl -->
        <Border Grid.Row="2" Background="{StaticResource PrimaryBrush}" 
                Margin="12,8,12,12" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="4" Opacity="0.1" BlurRadius="12"/>
            </Border.Effect>

            <TabControl x:Name="MainTabControl"
                        Background="Transparent" 
                        BorderThickness="0"
                        SelectedIndex="{Binding SelectedTabIndex}"
                        FontSize="13" 
                        FontWeight="SemiBold"
                        UseLayoutRounding="True">

                <!-- КЛИЕНТЫ TAB -->
                <TabItem Header="👥 Клиенты">
                    <Grid Margin="8" UseLayoutRounding="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Верхняя панель с кнопками -->
                        <Border Grid.Row="0" Background="{StaticResource SecondaryBrush}" 
                CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Управление клиентами" 
                           Foreground="{StaticResource TextBrush}"
                           FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="➕ Добавить клиента" 
                            Command="{Binding AddClientCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource SuccessBrush}"
                            Padding="12,6" FontSize="12"
                            Margin="0,0,8,0"/>
                                    <Button Content="🔄 Обновить" 
                            Command="{Binding RefreshClientsCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource WarningBrush}"
                            Padding="12,6" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Строка поиска и фильтрации -->
                        <Border Grid.Row="1" Background="{StaticResource SecondaryBrush}" 
                CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Левая часть - поиск (растянут на всю доступную ширину) -->
                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Поиск:" VerticalAlignment="Center" FontSize="12" Margin="5,0,10,0"/>
                                    <TextBox Grid.Column="1" 
                             Text="{Binding ClientSearchText, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="12" Height="30" VerticalContentAlignment="Center"
                             Tag="🔍 Поиск по названию компании, контактному лицу, email или телефону..."
                             Style="{StaticResource ModernTextBox}"/>
                                </Grid>

                                <!-- Правая часть - сортировка и фильтры -->
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,10,0">
                                    <TextBlock Text="Сортировка:" VerticalAlignment="Center" FontSize="12" Margin="5,0"/>
                                    <ComboBox SelectedItem="{Binding SelectedClientSort}" Width="150" FontSize="12" Height="28"
                              ItemsSource="{Binding ClientSortOptions}" DisplayMemberPath="Name"
                              Style="{StaticResource ModernComboBox}" Margin="0,0,10,0"/>

                                    <TextBlock Text="Дата регистрации:" VerticalAlignment="Center" FontSize="12" Margin="5,0"/>
                                    <DatePicker SelectedDate="{Binding ClientFilterStartDate, UpdateSourceTrigger=PropertyChanged}" Width="110" Height="28"
                                Style="{StaticResource ModernDatePicker}" FontSize="11"
                                Margin="0,0,5,0"/>
                                    <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <DatePicker SelectedDate="{Binding ClientFilterEndDate, UpdateSourceTrigger=PropertyChanged}" Width="110" Height="28"
                                Style="{StaticResource ModernDatePicker}" FontSize="11"/>
                                </WrapPanel>

                                <!-- Кнопка сброса фильтров -->
                                <Button Grid.Column="2" 
                        Content="✖ Сбросить фильтры" 
                        Command="{Binding ResetClientFiltersCommand}"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource BorderBrush}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Padding="12,6" FontSize="11"
                        ToolTip="Очистить все фильтры и поиск"/>
                            </Grid>
                        </Border>

                        <!-- Форма клиента -->
                        <Border Grid.Row="2" 
                Background="{StaticResource SecondaryBrush}" 
                CornerRadius="4" 
                Padding="12" 
                Margin="0,0,0,10" 
                BorderThickness="1" 
                BorderBrush="{StaticResource BorderBrush}"
                Visibility="{Binding IsClientFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding ClientFormTitle}" 
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="14" FontWeight="Bold"
                           Margin="0,0,0,10"/>

                                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Компания *" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CurrentClient.CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Height="32" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Контактное лицо" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CurrentClient.ContactPerson, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Height="32" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,0">
                                        <TextBlock Text="Email" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CurrentClient.Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Height="32" FontSize="12"/>
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,0">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Телефон" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CurrentClient.Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Height="32" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Адрес" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CurrentClient.Address, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Height="32" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Button Content="❌ Отмена" Command="{Binding CancelClientCommand}"
                                Style="{StaticResource ModernButton}" Background="{StaticResource ErrorBrush}"
                                Padding="15,6" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="💾 Сохранить" Command="{Binding SaveClientCommand}"
                                Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}"
                                Padding="15,6" FontSize="12"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- Таблица клиентов -->
                        <DataGrid Grid.Row="3" 
                                  ItemsSource="{Binding FilteredClients}"
                                  Style="{StaticResource ModernDataGrid}"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                                  RowStyle="{StaticResource ModernDataGridRow}"
                                  CellStyle="{StaticResource ModernDataGridCell}"
                                  AutoGenerateColumns="False"
                                  VerticalAlignment="Stretch"
                                  UseLayoutRounding="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding OrderNumber}" Width="50"/>
                                <DataGridTextColumn Header="Компания" Binding="{Binding CompanyName}" Width="*" MinWidth="180"/>
                                <DataGridTextColumn Header="Контактное лицо" Binding="{Binding ContactPerson}" Width="*" MinWidth="140"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" MinWidth="160"/>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*" MinWidth="120"/>
                                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*" MinWidth="150"/>
                                <DataGridTextColumn Header="Дата регистрации" 
                                   Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}" 
                                   Width="*" MinWidth="100"/>
                                <DataGridTemplateColumn Header="Действия" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️" 
                                        Command="{Binding DataContext.EditClientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Id}"
                                        Style="{StaticResource TextButton}"
                                        Padding="6,3"/>
                                                <Button Content="🗑️" 
                                        Command="{Binding DataContext.DeleteClientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Id}"
                                        Style="{StaticResource TextButton}"
                                        Margin="4,0,0,0"
                                        Foreground="{StaticResource ErrorBrush}"
                                        Padding="6,3"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ЗАКАЗЫ TAB (переработан) -->
                <TabItem Header="📦 Заказы">
                    <Grid Margin="8" UseLayoutRounding="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Верхняя панель с кнопками -->
                        <Border Grid.Row="0" Background="{StaticResource SecondaryBrush}" 
                                CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Управление заказами" 
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="14" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📊 Экспорт в Excel" 
                                            Command="{Binding ExportOrdersCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Background="{StaticResource SuccessBrush}"
                                            Padding="12,6" FontSize="12"
                                            Margin="0,0,8,0"/>
                                    <Button Content="➕ Создать заказ" 
                                            Command="{Binding AddOrderCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Background="{StaticResource AccentBrush}"
                                            Padding="12,6" FontSize="12"
                                            Margin="0,0,8,0"/>
                                    <Button Content="🔄 Обновить" 
                                            Command="{Binding RefreshOrdersCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Background="{StaticResource WarningBrush}"
                                            Padding="12,6" FontSize="12"
                                            Margin="0,0,8,0"/>
                                    <Button Content="📋 План работ" 
                                            Command="{Binding ShowWorkPlanCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Background="{StaticResource InfoBrush}"
                                            Padding="12,6" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Строка поиска -->
                        <Border Grid.Row="1" Background="{StaticResource SecondaryBrush}" 
                CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Поиск:" VerticalAlignment="Center" FontSize="12" Margin="5,0,10,0"/>
                                <TextBox Grid.Column="1" 
                         Text="{Binding OrderSearchText, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="12" Height="30" VerticalContentAlignment="Center"
                         Tag="🔍 Поиск по названию заказа, клиенту, категории, приоритету или статусу..."
                         Style="{StaticResource ModernTextBox}"/>
                                <Button Grid.Column="2" 
                        Content="✖ Сбросить фильтры" 
                        Command="{Binding ResetOrderFiltersCommand}"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource BorderBrush}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Padding="12,6" FontSize="11"
                        Margin="10,0,0,0"
                        ToolTip="Очистить все фильтры, поиск и сбросить сортировку"/>
                            </Grid>
                        </Border>

                        <!-- Панель фильтрации и сортировки -->
                        <Border Grid.Row="2" Background="{StaticResource SecondaryBrush}" 
                                CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <WrapPanel>
                                <TextBlock Text="Сортировка:" VerticalAlignment="Center" FontSize="12" Margin="5,0"/>
                                <ComboBox SelectedItem="{Binding SelectedOrderSort}" Width="160" FontSize="12" Height="28"
                                          ItemsSource="{Binding OrderSortOptions}" DisplayMemberPath="Name"
                                          Style="{StaticResource ModernComboBox}" Margin="0,0,15,0"/>

                                <TextBlock Text="Дата создания:" VerticalAlignment="Center" FontSize="12" Margin="5,0"/>
                                <DatePicker SelectedDate="{Binding OrderFilterStartDate}" Width="110" Height="28"
                                            Style="{StaticResource ModernDatePicker}" FontSize="11"
                                            Margin="0,0,5,0"/>
                                <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <DatePicker SelectedDate="{Binding OrderFilterEndDate}" Width="110" Height="28"
                                            Style="{StaticResource ModernDatePicker}" FontSize="11"
                                            Margin="0,0,15,0"/>

                                <TextBlock Text="Статусы:" VerticalAlignment="Center" FontSize="12" Margin="5,0"/>
                                <ComboBox ItemsSource="{Binding StatusFilterItems}" Width="160" Height="28"
                                          MaxHeight="120" Style="{StaticResource ModernComboBox}" Margin="0,0,15,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="5" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Приоритеты:" VerticalAlignment="Center" FontSize="12" Margin="5,0"/>
                                <ComboBox ItemsSource="{Binding PriorityFilterItems}" Width="140" Height="28"
                                          MaxHeight="120" Style="{StaticResource ModernComboBox}" Margin="0,0,15,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="5" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Категории:" VerticalAlignment="Center" FontSize="12" Margin="5,0"/>
                                <ComboBox ItemsSource="{Binding CategoryFilterItems}" Width="140" Height="28"
                                          MaxHeight="120" Style="{StaticResource ModernComboBox}" Margin="0,0,15,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="5" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </WrapPanel>
                        </Border>

                        <!-- Форма добавления/редактирования заказа -->
                        <Border Grid.Row="3" 
                                Background="{StaticResource SecondaryBrush}" 
                                CornerRadius="4" 
                                Padding="12" 
                                Margin="0,0,0,10" 
                                BorderThickness="1" 
                                BorderBrush="{StaticResource BorderBrush}"
                                Visibility="{Binding IsOrderFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding OrderFormTitle}" 
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="14" FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Клиент *" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding AllClients}" DisplayMemberPath="CompanyName" 
                                                      SelectedValuePath="Id" SelectedValue="{Binding CurrentOrder.ClientId}"
                                                      Style="{StaticResource ModernComboBox}" Height="32" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Категория *" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding AllCategories}" DisplayMemberPath="Name" 
                                                      SelectedValuePath="Id" SelectedValue="{Binding CurrentOrder.CategoryId}"
                                                      Style="{StaticResource ModernComboBox}" Height="32" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Приоритет *" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding AllPriorities}" DisplayMemberPath="Name" 
                                                      SelectedValuePath="Id" SelectedValue="{Binding CurrentOrder.PriorityId}"
                                                      Style="{StaticResource ModernComboBox}" Height="32" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Статус *" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding AllStatuses}" DisplayMemberPath="Name" 
                                                      SelectedValuePath="Id" SelectedValue="{Binding CurrentOrder.StatusId}"
                                                      Style="{StaticResource ModernComboBox}" Height="32" FontSize="12"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Менеджер *" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding AllManagers}" DisplayMemberPath="Name" 
                                                      SelectedValuePath="Id" SelectedValue="{Binding CurrentOrder.ManagerId}"
                                                      Style="{StaticResource ModernComboBox}" Height="32" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Программист" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding AllProgrammers}" DisplayMemberPath="Name" 
                                                      SelectedValuePath="Id" SelectedValue="{Binding CurrentOrder.ProgrammerId}"
                                                      Style="{StaticResource ModernComboBox}" Height="32" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Плановые часы *" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding CurrentOrder.EstimatedHours, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" Height="32" FontSize="12"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <Grid Grid.Row="3" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                            <TextBlock Text="Название *" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding CurrentOrder.Title, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" Height="32" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Width="150" Margin="0,0,10,0">
                                            <TextBlock Text="Срок выполнения" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                            <DatePicker SelectedDate="{Binding CurrentOrder.DueDate}" Style="{StaticResource ModernDatePicker}" Height="32"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Width="150">
                                            <TextBlock Text="Дата завершения" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                            <DatePicker SelectedDate="{Binding CurrentOrder.CompletedDate}" Style="{StaticResource ModernDatePicker}" Height="32"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="4" Margin="0,0,0,10">
                                        <TextBlock Text="Описание" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CurrentOrder.Description, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" Height="60" FontSize="12"
                                                 TextWrapping="Wrap" AcceptsReturn="True"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="❌ Отмена" Command="{Binding CancelOrderCommand}"
                                                Style="{StaticResource ModernButton}" Background="{StaticResource ErrorBrush}"
                                                Padding="15,6" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="💾 Сохранить" Command="{Binding SaveOrderCommand}"
                                                Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}"
                                                Padding="15,6" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>

                        <!-- Таблица заказов -->
                        <DataGrid Grid.Row="4" 
                                  ItemsSource="{Binding FilteredOrders}"
                                  SelectedItem="{Binding SelectedOrder}"
                                  Style="{StaticResource ModernDataGrid}"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                                  RowStyle="{StaticResource ModernDataGridRow}"
                                  CellStyle="{StaticResource ModernDataGridCell}"
                                  AutoGenerateColumns="False"
                                  VerticalAlignment="Stretch"
                                  UseLayoutRounding="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding OrderNumber}" Width="50"/>
                                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*" MinWidth="180"/>
                                <DataGridTextColumn Header="Клиент" Binding="{Binding Client.CompanyName}" Width="*" MinWidth="150"/>
                                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="*" MinWidth="120"/>
                                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority.Name}" Width="*" MinWidth="100"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status.Name}" Width="*" MinWidth="100"/>
                                <DataGridTextColumn Header="Срок выполнения" Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" Width="*" MinWidth="100"/>
                                <DataGridTextColumn Header="Прогресс" Binding="{Binding ProgressString}" Width="*" MinWidth="80"/>
                                <DataGridTemplateColumn Header="Действия" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️" 
                                                        Command="{Binding DataContext.EditOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding Id}"
                                                        Style="{StaticResource TextButton}"
                                                        Padding="6,3"/>
                                                <Button Content="🗑️" 
                                                        Command="{Binding DataContext.DeleteOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding Id}"
                                                        Style="{StaticResource TextButton}"
                                                        Margin="4,0,0,0"
                                                        Foreground="{StaticResource ErrorBrush}"
                                                        Padding="6,3"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ПЛАНЫ РАБОТ TAB -->
                <TabItem Header="📋 Планы работ">
                    <Grid Margin="8" UseLayoutRounding="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Верхняя панель с кнопками -->
                        <Border Grid.Row="0" Background="{StaticResource SecondaryBrush}" 
                CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Управление планами работ" 
                           Foreground="{StaticResource TextBrush}"
                           FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="➕ Создать план" 
                            Command="{Binding AddWorkPlanCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource SuccessBrush}"
                            Padding="12,6" FontSize="12"
                            Margin="0,0,8,0"/>
                                    <Button Content="🔄 Обновить" 
                            Command="{Binding RefreshWorkPlansCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource WarningBrush}"
                            Padding="12,6" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" Background="{StaticResource SecondaryBrush}" 
                CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Управление планами работ" 
                           Foreground="{StaticResource TextBrush}"
                           FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="➕ Создать план" 
                            Command="{Binding AddWorkPlanCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource SuccessBrush}"
                            Padding="12,6" FontSize="12"
                            Margin="0,0,8,0"/>
                                    <Button Content="🔄 Обновить" 
                            Command="{Binding RefreshWorkPlansCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource WarningBrush}"
                            Padding="12,6" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Строка поиска и фильтрации -->
                        <Border Grid.Row="1" Background="{StaticResource SecondaryBrush}" 
                CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Левая часть - поиск (растянут на всю доступную ширину) -->
                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Поиск:" VerticalAlignment="Center" FontSize="12" Margin="5,0,10,0"/>
                                    <TextBox Grid.Column="1" 
                             Text="{Binding WorkPlanSearchText, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="12" Height="30" VerticalContentAlignment="Center"
                             Tag="🔍 Поиск по описанию плана или шагам тестирования..."
                             Style="{StaticResource ModernTextBox}"/>
                                </Grid>

                                <!-- Правая часть - сортировка и фильтры -->
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,10,0">
                                    <TextBlock Text="Сортировка:" VerticalAlignment="Center" FontSize="12" Margin="5,0"/>
                                    <ComboBox SelectedItem="{Binding SelectedWorkPlanSort}" Width="150" FontSize="12" Height="28"
                              ItemsSource="{Binding WorkPlanSortOptions}" DisplayMemberPath="Name"
                              Style="{StaticResource ModernComboBox}" Margin="0,0,10,0"/>

                                    <TextBlock Text="Дата создания:" VerticalAlignment="Center" FontSize="12" Margin="5,0"/>
                                    <DatePicker SelectedDate="{Binding WorkPlanFilterStartDate, UpdateSourceTrigger=PropertyChanged}" Width="110" Height="28"
                                Style="{StaticResource ModernDatePicker}" FontSize="11"
                                Margin="0,0,5,0"/>
                                    <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <DatePicker SelectedDate="{Binding WorkPlanFilterEndDate, UpdateSourceTrigger=PropertyChanged}" Width="110" Height="28"
                                Style="{StaticResource ModernDatePicker}" FontSize="11"/>
                                </WrapPanel>

                                <!-- Кнопка сброса фильтров -->
                                <Button Grid.Column="2" 
                        Content="✖ Сбросить фильтры" 
                        Command="{Binding ResetWorkPlanFiltersCommand}"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource BorderBrush}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Padding="12,6" FontSize="11"
                        ToolTip="Очистить все фильтры и поиск"/>
                            </Grid>
                        </Border>

                        <!-- Форма плана -->
                        <Border Grid.Row="2" 
                Background="{StaticResource SecondaryBrush}" 
                CornerRadius="4" 
                Padding="12" 
                Margin="0,0,0,10" 
                BorderThickness="1" 
                BorderBrush="{StaticResource BorderBrush}"
                Visibility="{Binding IsWorkPlanFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding WorkPlanFormTitle}" 
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="14" FontWeight="Bold"
                           Margin="0,0,0,10"/>

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Описание *" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CurrentWorkPlan.PlanDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Height="32" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Часы *" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CurrentWorkPlan.EstimatedHours, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Height="32" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                    <TextBlock Text="Шаги тестирования" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CurrentWorkPlan.TestSteps, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Height="80" FontSize="12"
                             TextWrapping="Wrap" AcceptsReturn="True"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="❌ Отмена" Command="{Binding CancelWorkPlanCommand}"
                            Style="{StaticResource ModernButton}" Background="{StaticResource ErrorBrush}"
                            Padding="15,6" FontSize="12" Margin="0,0,8,0"/>
                                    <Button Content="💾 Сохранить" Command="{Binding SaveWorkPlanCommand}"
                            Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}"
                            Padding="15,6" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Таблица планов -->
                        <DataGrid Grid.Row="3" 
                  ItemsSource="{Binding FilteredWorkPlans}"
                  SelectedItem="{Binding SelectedWorkPlan}"
                  Style="{StaticResource ModernDataGrid}"
                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                  RowStyle="{StaticResource ModernDataGridRow}"
                  CellStyle="{StaticResource ModernDataGridCell}"
                  AutoGenerateColumns="False"
                  VerticalAlignment="Stretch"
                  UseLayoutRounding="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding OrderNumber}" Width="50"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding PlanDescription}" Width="*" MinWidth="250"/>
                                <DataGridTextColumn Header="Шаги плана" Binding="{Binding TestSteps}" Width="*" MinWidth="200"/>
                                <DataGridTextColumn Header="Часы" Binding="{Binding EstimatedHours}" Width="*" MinWidth="80"/>
                                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}" Width="*" MinWidth="100"/>
                                <DataGridTemplateColumn Header="Действия" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️" 
                                        Command="{Binding DataContext.EditWorkPlanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Id}"
                                        Style="{StaticResource TextButton}"
                                        Padding="6,3"/>
                                                <Button Content="🗑️" 
                                        Command="{Binding DataContext.DeleteWorkPlanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Id}"
                                        Style="{StaticResource TextButton}"
                                        Margin="4,0,0,0"
                                        Foreground="{StaticResource ErrorBrush}"
                                        Padding="6,3"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="{StaticResource PrimaryBrush}" 
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                   UseLayoutRounding="True">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="11"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Style="{StaticResource ModernProgressBar}"
                           Width="120" Height="6"
                           IsIndeterminate="{Binding IsLoading}" 
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Диалог планов работ -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="#CC000000"
                Visibility="{Binding IsWorkPlanDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource CardBrush}"
                    CornerRadius="8"
                    Padding="20"
                    Width="750"
                    Height="550"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="📋 ПЛАН РАБОТ" 
                                   Style="{StaticResource TitleTextStyle}"
                                   FontSize="18"/>
                        <TextBlock Text="{Binding SelectedOrder.Title, StringFormat=' - {0}'}"
                                   Style="{StaticResource TitleTextStyle}"
                                   FontSize="18"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="5,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource SecondaryBrush}" 
                            CornerRadius="4" Padding="10" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="➕ Добавить план" 
                                    Command="{Binding AddWorkPlanInDialogCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Background="{StaticResource SuccessBrush}"
                                    Margin="0,0,10,0"
                                    Padding="10,6"
                                    FontSize="12"/>
                            <TextBlock Text="{Binding WorkPlansForDialog.Count, StringFormat={}Планов: {0}}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="2" 
                              ItemsSource="{Binding WorkPlansForDialog}"
                              SelectedItem="{Binding SelectedWorkPlan}"
                              Style="{StaticResource ModernDataGrid}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              CellStyle="{StaticResource ModernDataGridCell}"
                              AutoGenerateColumns="False"
                              Margin="0,0,0,10"
                              MinHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding OrderNumber}" Width="50"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding PlanDescription}" Width="*" MinWidth="250"/>
                            <DataGridTextColumn Header="План действий" Binding="{Binding TestSteps}" Width="*" MinWidth="200"/>
                            <DataGridTextColumn Header="Часы" Binding="{Binding EstimatedHours}" Width="80"/>
                            <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTemplateColumn Header="Действия" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✏️" 
                                                    Command="{Binding DataContext.EditWorkPlanInDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource TextButton}"
                                                    Padding="6,3"/>
                                            <Button Content="🗑️" 
                                                    Command="{Binding DataContext.DeleteWorkPlanInDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource TextButton}"
                                                    Margin="4,0,0,0"
                                                    Foreground="{StaticResource ErrorBrush}"
                                                    Padding="6,3"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" 
                            Background="{StaticResource SecondaryBrush}" 
                            CornerRadius="4" 
                            Padding="12" 
                            BorderThickness="1" 
                            BorderBrush="{StaticResource BorderBrush}"
                            Visibility="{Binding IsWorkPlanFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}" 
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Название плана *" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CurrentWorkPlan.PlanDescription, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" Height="32" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Часы *" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CurrentWorkPlan.EstimatedHours, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" Height="32" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Text="План действий" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CurrentWorkPlan.TestSteps, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Height="80" FontSize="12"
                                         TextWrapping="Wrap" AcceptsReturn="True"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="💾 Сохранить" 
                                        Command="{Binding SaveWorkPlanInDialogCommand}"
                                        Style="{StaticResource ModernButton}"
                                        Background="{StaticResource SuccessBrush}"
                                        Margin="0,0,8,0"
                                        Padding="15,8"
                                        FontSize="12"/>
                                <Button Content="❌ Отмена" 
                                        Command="{Binding CancelWorkPlanInDialogCommand}"
                                        Style="{StaticResource ModernButton}"
                                        Background="{StaticResource ErrorBrush}"
                                        Padding="15,8"
                                        FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Grid.Row="0"
                            Command="{Binding CloseWorkPlanDialogCommand}"
                            Style="{StaticResource CloseButtonStyle}"
                            Content="✕"
                            FontSize="14"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,10,10,0"
                            Width="30" Height="30"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>